;;;
;;;  game.theory   --  the game half: maze, state, movement, ghosts, scoring.
;;;
;;;  Design after raylib-pacman (b12n-oss) and pacman.clj by Michiel Borkent
;;;  (MIT License). Original Premise implementation: code, maze layout, and
;;;  shim written fresh for this port; no source text copied. Binds raylib by
;;;  Ramon Santamaria (zlib license) at runtime. Pac-Man is a trademark of
;;;  Bandai Namco; no original assets are used. Credits: doc/pacman-readme.md.
;;;
;;; No raylib calls anywhere
;;; here. Grokked inside (theory Pacman ...) by the entry file, so every
;;; definition lands in the Pacman theory environment (Protocol 77).
;;;
;;; Coordinates: columns are x, rows are y, both 1-based (BASE = 1,
;;; Protocol 42). A tile (r c) spans [r, r+1) by [c, c+1); its centre is
;;; (r + 0.5, c + 0.5). Entity positions are continuous tile units.
;;; The one movement rule: a direction may only be chosen at the centre
;;; of a tile. Deciding anywhere else lets an entity slide into a wall.

;;; ------------------------------------------------------------------
;;; The maze. An original 19-by-21 layout, machine-verified: every dot
;;; reachable, ghosts can leave the house, the tunnel is open at both
;;; ends of row 10, no dead ends but the one-cell alcove above the door.
;;;   # wall   . dot   o power pellet   - ghost-house door
;;;   G house interior   P start   space: open floor, no dot
;;; Everything else -- start tiles, the door, the house, the dot count --
;;; is derived by reading these strings, never from a second table.

(let ?Rows 21)
(let ?Cols 19)
(let ?Maze {
  "###################"
  "#........#........#"
  "#o##.###.#.###.##o#"
  "#.................#"
  "#.##.#.##.##.#.##.#"
  "#....#.......#....#"
  "###.#####.#####.###"
  "#......##-##......#"
  "#.####.#GGG#.####.#"
  " ......#####...... "
  "#.####...P...####.#"
  "#......#####......#"
  "#.####.......####.#"
  "#......##.##......#"
  "###.#####.#####.###"
  "#....#.......#....#"
  "#.##.#.##.##.#.##.#"
  "#.................#"
  "#o##.###.#.###.##o#"
  "#........#........#"
  "###################"
})

;;; ------------------------------------------------------------------
;;; Grid derivation. Cells are literals: wall dot pellet door house empty.

(function cell-of {?ch}
  "Maps one maze character to a grid cell code."
  (case ?ch
    of "#" wall
    of "." dot
    of "o" pellet
    of "-" door
    of "G" house
    else   empty))

(function make-grid {}
  "Builds the 21-by-19 cell grid from the maze strings."
  (let ?grid (array {?Rows ?Cols} of empty))
  (step ?r from 1 to ?Rows
    (let ?row (@ ?Maze ?r))
    (step ?c from 1 to ?Cols
      (put ?grid {?r ?c} (cell-of (@ ?row ?c)))))
  ?grid)

(function tile-col {?c}
  "Wraps a column index into 1..19. This is the side tunnel; the
   addition before mod keeps negative indexes correct."
  (+ 1 (mod (+ (- ?c 1) ?Cols) ?Cols)))

(function grid-at {?grid ?r ?c}
  "The cell at row ?r and wrapped column ?c. Rows above or below the
   maze read as wall, so no bounds check is needed anywhere else."
  (if (or (< ?r 1) (> ?r ?Rows))
      wall
   else
      (get ?grid ?r (tile-col ?c))))

(function wall-p {?grid ?r ?c}
  "Blocks Pacman: walls and the ghost-house door."
  (let ?cell (grid-at ?grid ?r ?c))
  (or (= ?cell wall) (= ?cell door)))

(function ghost-wall-p {?grid ?r ?c}
  "Blocks ghosts: walls only, so a ghost may leave its house through
   the door and Pacman may not enter it."
  (= (grid-at ?grid ?r ?c) wall))

(function find-tile {?ch}
  "The first {row col} whose maze character is ?ch, or nil."
  (let ?found nil)
  (step ?r from 1 to ?Rows
    (let ?row (@ ?Maze ?r))
    (step ?c from 1 to ?Cols
      (if (and (nil-p ?found) (= (@ ?row ?c) ?ch))
          (set ?found {?r ?c}))))
  ?found)

(function find-all {?ch}
  "Every {row col} whose maze character is ?ch."
  (let ?found {})
  (step ?r from 1 to ?Rows
    (let ?row (@ ?Maze ?r))
    (step ?c from 1 to ?Cols
      (if (= (@ ?row ?c) ?ch)
          (--> & ?found {{?r ?c}}))))
  ?found)

(function count-dots {?grid}
  "How many dots and pellets the grid holds."
  (let ?n 0)
  (step ?r from 1 to ?Rows
    (step ?c from 1 to ?Cols
      (let ?cell (get ?grid ?r ?c))
      (if (or (= ?cell dot) (= ?cell pellet))
          (--> ++ ?n))))
  ?n)

;;; ------------------------------------------------------------------
;;; State. Ephemerons, not thoughts: this is frame-loop state, read and
;;; written sixty times a second, and it is never queried -- the object
;;; store has no business here. One Game root owns everything and is
;;; threaded through step and draw as a parameter.

(structure Pac
  :X 0 :Y 0            ; continuous position, tile units
  :DX 0 :DY 0          ; current heading, one of the four units or zero
  :NDX 0 :NDY 0        ; the buffered turn, applied at the next legal centre
  :FX 1 :FY 0          ; last non-zero heading: a stopped Pacman keeps facing
  :Mouth 0)            ; mouth animation phase

(structure Ghost
  :Name nil            ; Blinky Pinky Inky Clyde
  :ScatR 1 :ScatC 1    ; scatter corner tile
  :HomeR 1 :HomeC 1    ; respawn tile inside the house
  :X 0 :Y 0
  :DX 0 :DY -1
  :Fright 0            ; seconds of frightened time remaining
  :HomeTimer 0)        ; seconds until release from the house

(structure Game
  :Pac nil :Ghosts {} :Grid nil
  :DotsLeft 0
  :Score 0 :Lives 3 :Level 1
  :ModeTimer 0 :Chase no :Combo 0
  :Message nil :MsgTimer 0
  :Over no :Clock 0 :Frame 0
  :DoorR 0 :DoorC 0    ; derived from the maze
  :PacR 0 :PacC 0)     ; likewise

(function make-ghosts {}
  "Blinky starts on the tile above the door; the other three start on
   the house tiles, released on a staggered timer. Blinky is first in
   the list: Inky's target arithmetic reads him from position one."
  (let ?door (find-tile "-"))
  (let ?dr (@ ?door 1))
  (let ?dc (@ ?door 2))
  (let ?slots (find-all "G"))
  (let ?left   (@ ?slots 1))
  (let ?middle (@ ?slots 2))
  (let ?right  (@ ?slots 3))
  { (new Ghost :Name Blinky :ScatR 1     :ScatC (- ?Cols 1)
               :HomeR (@ ?middle 1) :HomeC (@ ?middle 2)
               :X (+ ?dc 0.5) :Y (- ?dr 0.5)
               :DX -1 :DY 0 :Fright 0 :HomeTimer 0)
    (new Ghost :Name Pinky  :ScatR 1     :ScatC 2
               :HomeR (@ ?middle 1) :HomeC (@ ?middle 2)
               :X (+ (@ ?middle 2) 0.5) :Y (+ (@ ?middle 1) 0.5)
               :DX 0 :DY -1 :Fright 0 :HomeTimer 1.0)
    (new Ghost :Name Inky   :ScatR ?Rows :ScatC (- ?Cols 1)
               :HomeR (@ ?left 1) :HomeC (@ ?left 2)
               :X (+ (@ ?left 2) 0.5) :Y (+ (@ ?left 1) 0.5)
               :DX 0 :DY -1 :Fright 0 :HomeTimer 3.0)
    (new Ghost :Name Clyde  :ScatR ?Rows :ScatC 2
               :HomeR (@ ?right 1) :HomeC (@ ?right 2)
               :X (+ (@ ?right 2) 0.5) :Y (+ (@ ?right 1) 0.5)
               :DX 0 :DY -1 :Fright 0 :HomeTimer 5.0) })

(function reset-positions {?game}
  "Puts Pacman on his start tile and rebuilds the ghosts. Used at game
   start, after a death, and on a new level."
  (let ?pac (get ?game :Pac))
  (put ?pac :X (+ (get ?game :PacC) 0.5))
  (put ?pac :Y (+ (get ?game :PacR) 0.5))
  (put ?pac :DX 0)  (put ?pac :DY 0)
  (put ?pac :NDX 0) (put ?pac :NDY 0)
  (put ?pac :FX 1)  (put ?pac :FY 0)
  (put ?pac :Mouth 0)
  (put ?game :Ghosts (make-ghosts))
  (put ?game :Combo 0))

(function new-game {}
  "Builds a fresh Game ephemeron: the state the loop threads."
  (let ?grid (make-grid))
  (let ?p    (find-tile "P"))
  (let ?door (find-tile "-"))
  (let ?game (new Game
    :Pac (new Pac)
    :Ghosts {} :Grid ?grid
    :DotsLeft (count-dots ?grid)
    :Score 0
    :Lives (setting Pacman Game :Lives)
    :Level 1
    :ModeTimer (setting Pacman Game :ScatterSecs)
    :Chase no :Combo 0
    :Message "READY!" :MsgTimer 2.0
    :Over no :Clock 0 :Frame 0
    :DoorR (@ ?door 1) :DoorC (@ ?door 2)
    :PacR (@ ?p 1) :PacC (@ ?p 2)))
  (reset-positions ?game)
  ?game)

;;; ------------------------------------------------------------------
;;; Deciding. The only place Pacman and the ghosts differ.

(function decide-pac {?grid ?tr ?tc ?dx ?dy ?ndx ?ndy}
  "Prefers the buffered turn, keeps the current heading, else stops.
   Pressing a turn a few tiles early takes effect at the junction."
  (if (and (or (/= 0 ?ndx) (/= 0 ?ndy))
           (not (wall-p ?grid (+ ?tr ?ndy) (+ ?tc ?ndx))))
      {?ndx ?ndy}
   or (and (or (/= 0 ?dx) (/= 0 ?dy))
           (not (wall-p ?grid (+ ?tr ?dy) (+ ?tc ?dx))))
      {?dx ?dy}
   else
      {0 0}))

(function chase-target {?game ?g}
  "The four personalities, four lines of arithmetic. Targets are
   {row col} tiles and need not be reachable; they only steer."
  (let ?pac (get ?game :Pac))
  (let ?ptr (floor (get ?pac :Y)))
  (let ?ptc (floor (get ?pac :X)))
  (let ?pdx (get ?pac :DX))
  (let ?pdy (get ?pac :DY))
  (case (get ?g :Name)
    of Blinky
      {?ptr ?ptc}                                  ; straight pursuit
    of Pinky
      {(+ ?ptr (* 4 ?pdy)) (+ ?ptc (* 4 ?pdx))}    ; four tiles ahead
    of Inky
      (let ?b (@ (get ?game :Ghosts) 1))           ; Blinky, by convention
      (let ?btr (floor (get ?b :Y)))
      (let ?btc (floor (get ?b :X)))
      (let ?ar (+ ?ptr (* 2 ?pdy)))
      (let ?ac (+ ?ptc (* 2 ?pdx)))
      {(- (* 2 ?ar) ?btr) (- (* 2 ?ac) ?btc)}      ; reflect Blinky through it
    else                                           ; Clyde
      (let ?gtr (floor (get ?g :Y)))
      (let ?gtc (floor (get ?g :X)))
      (let ?vr (- ?ptr ?gtr))
      (let ?vc (- ?ptc ?gtc))
      (if (> (+ (* ?vr ?vr) (* ?vc ?vc)) 64)       ; more than eight tiles off
          {?ptr ?ptc}                              ; chase
       else
          {(get ?g :ScatR) (get ?g :ScatC)})))     ; break for the corner

(function best-toward {?opts ?target ?tr ?tc}
  "The legal direction whose next tile is closest to the target by
   squared distance."
  (let ?tgr (@ ?target 1))
  (let ?tgc (@ ?target 2))
  (let ?best nil)
  (let ?bestd 999999)
  (for ?d in ?opts
    (let ?nr (+ ?tr (@ ?d 2)))
    (let ?nc (+ ?tc (@ ?d 1)))
    (let ?vr (- ?nr ?tgr))
    (let ?vc (- ?nc ?tgc))
    (let ?dist (+ (* ?vr ?vr) (* ?vc ?vc)))
    (if (< ?dist ?bestd)
        (set ?bestd ?dist)
        (set ?best ?d)))
  ?best)

(function decide-ghost {?game ?g ?tr ?tc}
  "At a centre a ghost takes the legal, non-reversing direction closest
   to its target. No reversal is what makes a ghost commit to a route;
   a dead end is the one case where the reversal is put back. A ghost
   inside the house targets the tile above the door until it is out.
   Frightened swaps the target for a random legal pick."
  (let ?grid (get ?game :Grid))
  (let ?dx (get ?g :DX))
  (let ?dy (get ?g :DY))
  (let ?cell (grid-at ?grid ?tr ?tc))
  (let ?target
    (if (or (= ?cell house) (= ?cell door))
        {(- (get ?game :DoorR) 1) (get ?game :DoorC)}
     or (> (get ?g :Fright) 0)
        nil
     or (= yes (get ?game :Chase))
        (chase-target ?game ?g)
     else
        {(get ?g :ScatR) (get ?g :ScatC)}))
  (let ?opts {})
  (for ?d in {{0 -1} {-1 0} {0 1} {1 0}}
    (let ?ox (@ ?d 1))
    (let ?oy (@ ?d 2))
    (if (and (not (and (= ?ox (- 0 ?dx)) (= ?oy (- 0 ?dy))))
             (not (ghost-wall-p ?grid (+ ?tr ?oy) (+ ?tc ?ox))))
        (--> & ?opts {{?ox ?oy}})))
  (if (= 0 (# ?opts))
      (set ?opts {{(- 0 ?dx) (- 0 ?dy)}}))
  (if (nil-p ?target)
      (@ (pick ?opts 1) 1)
   else
      (best-toward ?opts ?target ?tr ?tc)))

;;; ------------------------------------------------------------------
;;; Moving. One rule, shared shape: advance by speed * dt; if this step
;;; reaches the tile centre, stop there, ask decide, and spend the
;;; leftover distance on the new heading. The -0.000000001 is there
;;; because floating point lands on the centre approximately.

(function wrap-x {?x}
  "Walking off one end of the tunnel arrives at the other."
  (if (< ?x 1)
      (+ ?x ?Cols)
   or (>= ?x (+ ?Cols 1))
      (- ?x ?Cols)
   else
      ?x))

(function step-pac {?game ?dt}
  (let ?pac  (get ?game :Pac))
  (let ?grid (get ?game :Grid))
  (let ?dist (* (setting Pacman Game :PacSpeed) ?dt))
  (let ?x  (get ?pac :X))
  (let ?y  (get ?pac :Y))
  (let ?dx (get ?pac :DX))
  (let ?dy (get ?pac :DY))
  (let ?cx (+ (floor ?x) 0.5))
  (let ?cy (+ (floor ?y) 0.5))
  (let ?toc (+ (* ?dx (- ?cx ?x)) (* ?dy (- ?cy ?y))))
  (if (and (>= ?toc -0.000000001) (<= ?toc ?dist))
      ;; this step reaches the centre: choose, spend the remainder
      (let ?tr (floor ?cy))
      (let ?tc (floor ?cx))
      (let ?dir (decide-pac ?grid ?tr ?tc ?dx ?dy
                            (get ?pac :NDX) (get ?pac :NDY)))
      (let ?nx (@ ?dir 1))
      (let ?ny (@ ?dir 2))
      (let ?rem (- ?dist ?toc))
      (put ?pac :X (wrap-x (+ ?cx (* ?nx ?rem))))
      (put ?pac :Y (+ ?cy (* ?ny ?rem)))
      (put ?pac :DX ?nx)
      (put ?pac :DY ?ny)
      (if (or (/= 0 ?nx) (/= 0 ?ny))
          (put ?pac :FX ?nx)
          (put ?pac :FY ?ny))
   else
      ;; otherwise just keep going
      (put ?pac :X (wrap-x (+ ?x (* ?dx ?dist))))
      (put ?pac :Y (+ ?y (* ?dy ?dist))))
  (if (or (/= 0 (get ?pac :DX)) (/= 0 (get ?pac :DY)))
      (==> ?pac + :Mouth (* 10 ?dt))))

(function step-ghost {?game ?g ?dt}
  (let ?grid (get ?game :Grid))
  (if (> (get ?g :Fright) 0)
      (put ?g :Fright (max 0 (- (get ?g :Fright) ?dt))))
  (if (> (get ?g :HomeTimer) 0)
      ;; still home: count down, hold position
      (put ?g :HomeTimer (- (get ?g :HomeTimer) ?dt))
   else
      (let ?speed (if (> (get ?g :Fright) 0)
                      (setting Pacman Game :FrightSpeed)
                   else
                      (setting Pacman Game :GhostSpeed)))
      (let ?dist (* ?speed ?dt))
      (let ?x  (get ?g :X))
      (let ?y  (get ?g :Y))
      (let ?dx (get ?g :DX))
      (let ?dy (get ?g :DY))
      (let ?cx (+ (floor ?x) 0.5))
      (let ?cy (+ (floor ?y) 0.5))
      (let ?toc (+ (* ?dx (- ?cx ?x)) (* ?dy (- ?cy ?y))))
      (if (and (>= ?toc -0.000000001) (<= ?toc ?dist))
          (let ?tr (floor ?cy))
          (let ?tc (floor ?cx))
          (let ?dir (decide-ghost ?game ?g ?tr ?tc))
          (let ?nx (@ ?dir 1))
          (let ?ny (@ ?dir 2))
          (let ?rem (- ?dist ?toc))
          (put ?g :X (wrap-x (+ ?cx (* ?nx ?rem))))
          (put ?g :Y (+ ?cy (* ?ny ?rem)))
          (put ?g :DX ?nx)
          (put ?g :DY ?ny)
       else
          (put ?g :X (wrap-x (+ ?x (* ?dx ?dist))))
          (put ?g :Y (+ ?y (* ?dy ?dist))))))

;;; ------------------------------------------------------------------
;;; Eating, dying, clearing.

(function frighten-all {?game}
  (for ?g in (get ?game :Ghosts)
    (put ?g :Fright (setting Pacman Game :FrightSecs)))
  (put ?game :Combo 0))

(function eat-at {?game}
  "Eats whatever sits on Pacman's tile."
  (let ?pac  (get ?game :Pac))
  (let ?grid (get ?game :Grid))
  (let ?tr (floor (get ?pac :Y)))
  (let ?tc (tile-col (floor (get ?pac :X))))
  (let ?cell (grid-at ?grid ?tr ?tc))
  (if (= ?cell dot)
      (put ?grid {?tr ?tc} empty)
      (==> ?game + :Score 10)
      (==> ?game + :DotsLeft -1)
   or (= ?cell pellet)
      (put ?grid {?tr ?tc} empty)
      (==> ?game + :Score 50)
      (==> ?game + :DotsLeft -1)
      (frighten-all ?game)))

(function eat-ghost {?game ?g}
  "One pellet scores 200, 400, 800, 1600."
  (==> ?game + :Score (* 200 (** 2 (get ?game :Combo))))
  (==> ?game + :Combo 1)
  (put ?g :X (+ (get ?g :HomeC) 0.5))
  (put ?g :Y (+ (get ?g :HomeR) 0.5))
  (put ?g :DX 0)
  (put ?g :DY -1)
  (put ?g :Fright 0)
  (put ?g :HomeTimer 3.0))

(function pac-dies {?game}
  (==> ?game + :Lives -1)
  (if (<= (get ?game :Lives) 0)
      (put ?game :Over yes)
      (put ?game :Message "GAME OVER -- ENTER restarts")
   else
      (reset-positions ?game)
      (put ?game :Message "READY!")
      (put ?game :MsgTimer 2.0)))

(function collide {?game}
  "After everything has moved: sharing Pacman's tile is contact."
  (let ?pac (get ?game :Pac))
  (let ?ptr (floor (get ?pac :Y)))
  (let ?ptc (floor (get ?pac :X)))
  (for ?g in (get ?game :Ghosts)
    (if (and (= no (get ?game :Over))
             (<= (get ?g :HomeTimer) 0)
             (= ?ptr (floor (get ?g :Y)))
             (= ?ptc (floor (get ?g :X))))
        (if (> (get ?g :Fright) 0)
            (eat-ghost ?game ?g)
         else
            (pac-dies ?game)))))

(function next-level {?game}
  (==> ?game + :Level 1)
  (put ?game :Grid (make-grid))
  (put ?game :DotsLeft (count-dots (get ?game :Grid)))
  (reset-positions ?game)
  (put ?game :Chase no)
  (put ?game :ModeTimer (setting Pacman Game :ScatterSecs))
  (put ?game :Message ($ "LEVEL" (get ?game :Level)))
  (put ?game :MsgTimer 2.0))

;;; ------------------------------------------------------------------
;;; The frame step. Reads input already buffered on the Pac ephemeron,
;;; returns the same threaded Game. Nothing under here draws.

(function step {?game ?dt}
  (==> ?game + :Clock ?dt)
  (if (> (get ?game :MsgTimer) 0)
      ;; READY! and LEVEL n freeze the world briefly
      (put ?game :MsgTimer (- (get ?game :MsgTimer) ?dt))
      (if (<= (get ?game :MsgTimer) 0)
          (put ?game :Message nil))
   else
      ;; scatter and chase alternate on a timer
      (put ?game :ModeTimer (- (get ?game :ModeTimer) ?dt))
      (if (<= (get ?game :ModeTimer) 0)
          (if (= yes (get ?game :Chase))
              (put ?game :Chase no)
              (put ?game :ModeTimer (setting Pacman Game :ScatterSecs))
           else
              (put ?game :Chase yes)
              (put ?game :ModeTimer (setting Pacman Game :ChaseSecs))))
      (step-pac ?game ?dt)
      (eat-at ?game)
      (for ?g in (get ?game :Ghosts)
        (step-ghost ?game ?g ?dt))
      (collide ?game)
      (if (and (= no (get ?game :Over)) (= 0 (get ?game :DotsLeft)))
          (next-level ?game)))
  ?game)
